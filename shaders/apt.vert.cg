// skate vita retail HUD (APT movie): the movie's stage coordinates to clip space.
// stage = (scale, offset x, offset y) from stage pixels to screen pixels.
uniform float3 stage;
uniform float2 screen; // width, height in pixels

void main(
	float2 aPosition,
	float2 aTexcoord,
	float2 out vTexcoord : TEXCOORD0,
	float4 out gl_Position : POSITION
) {
	float2 p = aPosition * stage.x + stage.yz;
	gl_Position = float4(p.x / screen.x * 2.0f - 1.0f, 1.0f - p.y / screen.y * 2.0f, 0.0f, 1.0f);
	vTexcoord = aTexcoord;
}
