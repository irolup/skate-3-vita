// skate vita traffic car body (L1c): the retail paint rule of `vehicle_defaultPS` (upstream PR #52
// `living_world/vehicles.rs`): lin = diffuse^2; a texel with G^2 < 0.001225 becomes
// R^2 x i_colorize_red + B^2 x i_colorize_blue (red = the secondary colour, blue = the chassis
// colour), any other keeps lin; sqrt at the end. Then the skin lighting.
uniform sampler2D tex;
uniform float4 tint;
uniform float4 red;
uniform float4 blue;

// The colour grade (retail post FX colour matrix, `skate_core::colour_matrix`): near and far 3x4 rows, blended by
// the vertex's depth weight; identity unless a record (the zombie cheat) is on.
uniform float4 grade[6];
float3 graded(float3 c, float w) {
	float4 x = float4(c, 1.0f);
	float3 n = float3(dot(grade[0], x), dot(grade[1], x), dot(grade[2], x));
	float3 f = float3(dot(grade[3], x), dot(grade[4], x), dot(grade[5], x));
	return lerp(n, f, w);
}

float4 main(float2 vTexcoord : TEXCOORD0, float4 vColor : COLOR) : COLOR {
	float4 c = tex2D(tex, vTexcoord) * tint;
	float3 lin = c.rgb * c.rgb;
	if (lin.g < 0.001225)
		lin = lin.r * red.rgb + lin.b * blue.rgb;
	return float4(graded(sqrt(lin) * vColor.rgb, vColor.a), 1.0f);
}
