// skate vita retail park: albedo and lightmap UVs, linear distance fog (PLAN.md §6.2).
uniform float4x4 viewproj;
uniform float3 eye;
uniform float2 fog; // start, end distance in metres

void main(
	float3 aPosition,
	float2 aUv,
	float2 aLightmapUv,
	float2 out vUv : TEXCOORD0,
	float2 out vLightmapUv : TEXCOORD1,
	float out vFog : TEXCOORD2,
	float4 out gl_Position : POSITION
) {
	gl_Position = mul(float4(aPosition, 1.0f), viewproj);
	vUv = aUv;
	vLightmapUv = aLightmapUv;
	vFog = saturate((fog.y - distance(aPosition, eye)) / (fog.y - fog.x));
}
