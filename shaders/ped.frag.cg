// skate vita pedestrian (L1e): every ped material in one program. The body (`paint` 1) takes the
// retail ped shader rule (`skate_core::living_world::peds::colorize`, the same as the cars'): lin =
// diffuse^2; a texel with G^2 < 0.001225 becomes R^2 x red (tint A) + B^2 x blue (tint B), sqrt at
// the end. Masked materials (hair) keep their cutoff; `fade` is the draw / spawn fade opacity.
uniform sampler2D tex;
uniform float4 tint;
uniform float4 red;
uniform float4 blue;
uniform float paint;
uniform float cutoff;
uniform float fade;

// The colour grade (retail post FX colour matrix, `skate_core::colour_matrix`): near and far 3x4 rows, blended by
// the vertex's depth weight; identity unless a record (the zombie cheat) is on.
uniform float4 grade[6];
float3 graded(float3 c, float w) {
	float4 x = float4(c, 1.0f);
	float3 n = float3(dot(grade[0], x), dot(grade[1], x), dot(grade[2], x));
	float3 f = float3(dot(grade[3], x), dot(grade[4], x), dot(grade[5], x));
	return lerp(n, f, w);
}

float4 main(float2 vTexcoord : TEXCOORD0, float4 vColor : COLOR) : COLOR {
	float4 c = tex2D(tex, vTexcoord) * tint;
	if (c.a < cutoff)
		discard;
	float3 rgb = c.rgb;
	if (paint > 0.5) {
		float3 lin = rgb * rgb;
		if (lin.g < 0.001225)
			lin = lin.r * red.rgb + lin.b * blue.rgb;
		rgb = sqrt(lin);
	}
	return float4(graded(rgb * vColor.rgb, vColor.a), fade);
}
