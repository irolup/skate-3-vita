// skate vita skater: GPU skinning with the 40-joint palette (35 until L1e: the peds have 39 joints) (root * joint global *
// inverse bind, computed on the CPU), one directional N.L term plus ambient per
// vertex (PLAN.md §6.2). Matrices are column-major GL data, so vectors multiply on
// the left (vitaGL convention).
uniform float4x4 viewproj;
uniform float4x4 bones[40];
uniform float3 lightDir; // unit vector towards the light
uniform float2 light;    // ambient, diffuse

void main(
	float3 aPosition,
	float3 aNormal,
	float2 aTexcoord,
	float4 aJoints,
	float4 aWeights,
	float2 out vTexcoord : TEXCOORD0,
	float4 out vColor : COLOR,
	float4 out gl_Position : POSITION
) {
	float4 p = float4(aPosition, 1.0f);
	float4 n = float4(aNormal, 0.0f);
	float4x4 b0 = bones[(int)aJoints.x];
	float4x4 b1 = bones[(int)aJoints.y];
	float4x4 b2 = bones[(int)aJoints.z];
	float4x4 b3 = bones[(int)aJoints.w];
	float4 world = mul(p, b0) * aWeights.x + mul(p, b1) * aWeights.y
	             + mul(p, b2) * aWeights.z + mul(p, b3) * aWeights.w;
	float3 normal = (mul(n, b0) * aWeights.x + mul(n, b1) * aWeights.y
	               + mul(n, b2) * aWeights.z + mul(n, b3) * aWeights.w).xyz;
	gl_Position = mul(float4(world.xyz, 1.0f), viewproj);
	float lit = light.x + light.y * max(dot(normalize(normal), lightDir), 0.0f);
	vColor = float4(lit, lit, lit, 1.0f);
	vTexcoord = aTexcoord;
}
