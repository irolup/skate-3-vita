// skate vita skater, alpha-masked materials (hair): alpha test against the cutoff.
uniform sampler2D tex;
uniform float4 tint;
uniform float cutoff;

// The colour grade (retail post FX colour matrix, `skate_core::colour_matrix`): near and far 3x4 rows, blended by
// the vertex's depth weight; identity unless a record (the zombie cheat) is on.
uniform float4 grade[6];
float3 graded(float3 c, float w) {
	float4 x = float4(c, 1.0f);
	float3 n = float3(dot(grade[0], x), dot(grade[1], x), dot(grade[2], x));
	float3 f = float3(dot(grade[3], x), dot(grade[4], x), dot(grade[5], x));
	return lerp(n, f, w);
}

// Retail's character shading (`mode` x 1): the light came halved, `tone` x is 2 x gain x the scene's exposure; the
// colour is linear (albedo squared x a linear tint) and goes through the retail tone curve, as the parks' (park.frag.cg).
uniform float2 tone;
float3 shaded(float3 albedo, float3 light) {
	if (tone.y < 0.5f)
		return albedo * light;
	float3 x = albedo * albedo * light * tone.x;
	float3 t = saturate(1.0f - x);
	float3 tm = max(x * 0.25f + 0.75f, 1.0f) - t * t;
	return saturate(sqrt(max(tm * 0.5f, 0.0f)) * 1.41f);
}

float4 main(float2 vTexcoord : TEXCOORD0, float4 vColor : COLOR) : COLOR {
	float4 c = tex2D(tex, vTexcoord) * tint;
	if (c.a < cutoff)
		discard;
	return float4(graded(shaded(c.rgb, vColor.rgb), vColor.a), 1.0f);
}
