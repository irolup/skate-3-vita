// skate vita 2D UI: pixel coordinates (origin top left) to clip space.
uniform float2 screen; // width, height in pixels

void main(
	float2 aPosition,
	float2 aTexcoord,
	float4 aColor,
	float2 out vTexcoord : TEXCOORD0,
	float4 out vColor : COLOR,
	float4 out gl_Position : POSITION
) {
	gl_Position = float4(aPosition.x / screen.x * 2.0f - 1.0f,
	                     1.0f - aPosition.y / screen.y * 2.0f, 0.0f, 1.0f);
	vTexcoord = aTexcoord;
	vColor = aColor;
}
