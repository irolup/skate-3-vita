// skate vita world (procedural Course): baked per-face lighting in the vertex colour,
// linear distance fog (PLAN.md §6.2).
uniform float4x4 viewproj;
uniform float3 eye;
uniform float2 fog; // start, end distance in metres

void main(
	float3 aPosition,
	float4 aColor,
	float4 out vColor : COLOR,
	float out vFog : TEXCOORD0,
	float4 out gl_Position : POSITION
) {
	gl_Position = mul(float4(aPosition, 1.0f), viewproj);
	vColor = aColor;
	float d = distance(aPosition, eye);
	vFog = saturate((fog.y - d) / (fog.y - fog.x));
}
